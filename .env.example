# ---- Threads (Meta app, "Threads API" use case) ----
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost/callback

# ---- X / Twitter (developer portal, OAuth 2.0, type: Web App / confidential) ----
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8787/callback

# ---- TikTok (developers.tiktok.com, Content Posting API, scope video.publish) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://localhost/callback

# ---- Instagram Reels (Meta app, "Instagram API with Instagram Login") ----
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://localhost/callback

# Public base URL where you host video/image files (Shopify Files, R2, etc.)
# Threads and Instagram fetch media by URL; they can't take a local file.
PUBLIC_MEDIA_BASE_URL=
